// ═══════════════════════════════════════════════════════════════
// Schéma Prisma — DevConnect (J4 — ajout du password)
// ═══════════════════════════════════════════════════════════════
// Ce fichier décrit ta base de données : les tables, les colonnes,
// les relations. Prisma le lit pour générer le SQL (migrations) et
// le client JavaScript qu'on utilise dans les routes.
//
// État à l'arrivée du J4 (héritage du J3) :
//   • 3 models déjà définis : User, Post (1-N avec User), Like (N-N
//     via clé composite). Tu n'as PAS à les recoder.
//   • 3 migrations déjà appliquées : init, add-posts, add-likes.
//   • Le seed peuple 5 users + 10 posts + 21 likes.
//
// 🔧 CE QUI CHANGE AU J4 :
//   Le model User n'a pas de champ `password`. C'est ce qu'on va
//   corriger à l'atelier 1, avec une 4ᵉ migration `add-password`.
// ═══════════════════════════════════════════════════════════════

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}


// ═══════════════════════════════════════════════════════════════
// 🔧 ATELIER 1 — À TOI DE JOUER : ajoute le champ `password` au User
// ═══════════════════════════════════════════════════════════════
//
// On va stocker en DB le hash bcrypt du password de chaque user
// (jamais le password en clair).
//
// Ajoute une colonne :
//
//   password  String
//
// → `String` (et pas `String?`) parce qu'on veut FORCER chaque user
// à avoir un password (contrainte au niveau base).
//
// ─── ⚠️ TU VAS VIVRE UN PROBLÈME DE PROD ──────────────────────
//
// Quand tu lanceras `npx prisma migrate dev --name add-password`,
// Prisma va râler : il y a déjà 5 users seedés du J3, et il ne sait
// pas quelle valeur de password mettre pour eux. Il refuse.
//
// La stratégie qu'on prend en dev (RACCOURCI à NE PAS faire en prod) :
//
//   rm prisma/dev.db                                          # jeter la DB
//   npx prisma migrate dev --name add-password --skip-seed    # tout recréer
//   npx prisma db seed                                        # repeupler (APRÈS avoir adapté seed.js)
//
// Pourquoi `--skip-seed` ? Sans ce flag, Prisma lance auto le seed
// après avoir recréé la DB. Mais le seed n'est pas encore adapté pour
// fournir le password → il planterait. On le skip, on adapte le seed
// à l'étape suivante, on le lance manuellement.
//
// 💡 Le détail "en prod on ferait autrement" (default temporaire,
//    backfill, migration en plusieurs étapes…) est expliqué en
//    correction live coding. Pour l'atelier on prend le raccourci.
// ═══════════════════════════════════════════════════════════════

model User {
  id        Int      @id @default(autoincrement())
  username  String   @unique
  email     String   @unique
  // ↓ ajoute ici la colonne password (ex. après email)
  createdAt DateTime @default(now())

  posts     Post[]
  likes     Like[]
}


// ═══════════════════════════════════════════════════════════════
// ✅ HÉRITAGE J3 — Post (relation 1-N avec User)
// ═══════════════════════════════════════════════════════════════
// Ne touche pas à ce model — il vient du J3.
// ═══════════════════════════════════════════════════════════════
model Post {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id])
  content   String
  createdAt DateTime @default(now())
  likes     Like[]
}


// ═══════════════════════════════════════════════════════════════
// ✅ HÉRITAGE J3 — Like (relation N-N via clé composite)
// ═══════════════════════════════════════════════════════════════
// Ne touche pas à ce model — il vient du J3.
// ═══════════════════════════════════════════════════════════════
model Like {
  userId    Int
  user      User     @relation(fields: [userId], references: [id])
  postId    Int
  post      Post     @relation(fields: [postId], references: [id])
  createdAt DateTime @default(now())

  @@id([userId, postId])
}
