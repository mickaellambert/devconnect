// ═══════════════════════════════════════════════════════════════
// Schéma Prisma — DevConnect
// ═══════════════════════════════════════════════════════════════
// Ce fichier décrit ta base de données : les tables, les colonnes,
// les relations. Prisma le lit pour générer le SQL (migrations) et
// le client JavaScript qu'on utilise dans les routes.
//
// Doc : https://www.prisma.io/docs/concepts/components/prisma-schema
// ═══════════════════════════════════════════════════════════════

// Où est la base et quel type de DB on utilise.
datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// Comment générer le client JavaScript adapté à ce schéma.
generator client {
  provider = "prisma-client-js"
}


// ═══════════════════════════════════════════════════════════════
// 🔧 ATELIER 1 — À TOI DE JOUER : écris le modèle User
// ═══════════════════════════════════════════════════════════════
//
// ⚠️ AVANT DE TAPER QUOI QUE CE SOIT — la syntaxe Prisma N'EST PAS
//    DU JAVASCRIPT. C'est un langage à part. Tu écris :
//
//      • PAS de virgules entre les colonnes
//      • PAS de virgules entre les attributs (@id @default sans virgule)
//      • PAS de point-virgules
//      • PAS de `:` entre le nom et le type
//
//    Format d'une colonne :   <nom>  <type>  <attribut1> <attribut2>
//                              ↑      ↑       ↑          ↑
//                              espace, juste des espaces, c'est tout
//
// ─── LE MODÈLE À OBTENIR ──────────────────────────────────────
//
// On veut une table User avec 4 colonnes :
//
//      • id          → un entier, clé primaire, auto-incrémenté
//      • username    → une string, unique
//      • email       → une string, unique
//      • createdAt   → une DateTime, valeur par défaut = maintenant
//
// ─── SQUELETTE À COMPLÉTER ────────────────────────────────────
//
//   model User {
//     id        Int      @id @default(autoincrement())
//     // ↓ À toi : ajoute les 3 autres colonnes
//
//     // username  → String, unique
//     // email     → String, unique
//     // createdAt → DateTime, valeur par défaut = now()
//   }
//
// ─── ATTRIBUTS UTILES ─────────────────────────────────────────
//
//   @id                       → marque la clé primaire
//   @default(autoincrement()) → auto-incrémenté (entier)
//   @unique                   → contrainte d'unicité
//   @default(now())           → valeur par défaut = date courante
//
// 💡 Tu peux empiler plusieurs attributs sur une colonne, séparés par
//    des espaces : @id @default(autoincrement())
//
// ⚠️ Le champ `password` arrivera au J4 (avec une migration dédiée
//    qui illustrera concrètement le concept de migration incrémentale).
//    Pour aujourd'hui, on ne le met pas — on bosse comme au J2.
//
// 💡 À l'atelier 2, on AJOUTERA des relations à ce modèle User :
//      posts Post[]   // un user a plusieurs posts (1-N)
//      likes Like[]   // un user fait plusieurs likes (1-N vers Like)
//    Pour l'atelier 1, on n'a pas encore besoin de ces lignes.
//
// 📚 Doc des types : https://www.prisma.io/docs/orm/reference/prisma-schema-reference#model-fields
// ═══════════════════════════════════════════════════════════════

// Écris ton model User ci-dessous :

model User {
  id        Int      @id @default(autoincrement())
  username  String   @unique
  email     String   @unique
  createdAt DateTime @default(now())
}


// ═══════════════════════════════════════════════════════════════
// 🔧 ATELIER 2 — À TOI DE JOUER : écris le modèle Post (relation 1-N)
// ═══════════════════════════════════════════════════════════════
//
// On va modéliser que chaque Post appartient à UN User (son auteur),
// et qu'un User peut avoir PLUSIEURS Posts. C'est une relation
// "un-à-plusieurs" (1-N).
//
// ─── COMMENT MARCHE UNE RELATION 1-N EN PRISMA ────────────────
//
// Côté Post (le "N", l'enfant) : on a DEUX champs liés :
//
//      userId  Int                                       ← la "foreign key" (la VRAIE colonne SQL,
//                                                          contient juste un nombre = l'id de User)
//      user    User  @relation(fields: [userId], references: [id])
//                                                        ↑
//                                            la "navigation property" :
//                                            PAS une colonne SQL — c'est un raccourci JS pour
//                                            écrire `post.user` (Prisma va chercher le User
//                                            correspondant tout seul, sans 2e requête à écrire).
//
// 💡 Pourquoi les crochets `[ ]` dans `fields: [userId]` et `references: [id]` ?
//    Parce que ces options acceptent **plusieurs** champs (utile pour les FK
//    composites, cas rare). Ici on en a qu'un seul mais on garde la syntaxe
//    tableau. Tu reverras des crochets pareils dans `@@id([userId, postId])`
//    sur le model Like plus bas — même logique.
//
// Côté User (le "1", le parent) : on AJOUTE juste une collection :
//
//      posts   Post[]                                    ← "Post[]" = "un tableau de Posts"
//                                                          (comme `Array<Post>` en TS, ou `Post[]` en Java)
//
// ⚠️ La relation DOIT être déclarée des DEUX côtés.
//    Prisma râle sinon : "the relation is not complete".
//
// ─── LE MODÈLE À OBTENIR ──────────────────────────────────────
//
// On veut une table Post avec :
//
//      • id        → entier, clé primaire, auto-incrémenté
//      • userId    → entier (la foreign key vers User)
//      • user      → relation vers User (navigation property)
//      • content   → string
//      • createdAt → DateTime, défaut = now()
//
// ─── SQUELETTE À COMPLÉTER ────────────────────────────────────
//
//   model Post {
//     id        Int      @id @default(autoincrement())
//     userId    Int
//     user      User     @relation(fields: [userId], references: [id])
//     // ↓ À toi : ajoute content et createdAt
//
//     // content   → String
//     // createdAt → DateTime, valeur par défaut = now()
//   }
//
// 🔧 N'OUBLIE PAS d'ajouter `posts Post[]` dans le modèle User ci-dessus !
//
// ─── MIGRATION ─────────────────────────────────────────────────
//
// Une fois le modèle Post écrit (et `posts Post[]` ajouté dans User) :
//   npx prisma migrate dev --name add-posts
//
// Tu verras une 2e migration apparaître dans `prisma/migrations/`.
// C'est ça, une migration INCRÉMENTALE : un fichier .sql qui ajoute
// la table Post à la base existante, sans toucher à User.
//
// ⏸️ NE LANCE PAS ENCORE LE SEED. On attend d'avoir aussi le modèle
//    Like ci-dessous (pour seeder posts + likes en une fois). Si tu
//    le lances maintenant, le seed marche, mais il s'arrêtera à
//    "10 posts en base" (pas de likes) car Like n'existe pas encore.
// ═══════════════════════════════════════════════════════════════

