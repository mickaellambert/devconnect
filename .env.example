# ─────────────────────────────────────────────────────────────────
# Modèle de fichier .env pour DevConnect
# ─────────────────────────────────────────────────────────────────
# Copie ce fichier sous le nom `.env` (commande : cp .env.example .env)
# puis remplis les valeurs. Le fichier `.env` n'est PAS commité (cf. .gitignore).
# ─────────────────────────────────────────────────────────────────

# J2 — Atelier 1 : port du serveur
PORT=4000

# J2 — Atelier 3 : credentials du serveur SMTP (Ethereal pour la formation)
# Crée ton compte sur https://ethereal.email/create puis recopie ici les valeurs.
SMTP_HOST=smtp.ethereal.email
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# J3 — Base de données SQLite (Prisma)
# `DATABASE_URL` indique à Prisma OÙ est la DB. Pour SQLite, c'est un
# chemin de fichier (préfixé `file:`). Le fichier sera créé tout seul
# à la 1ʳᵉ migration — pas besoin de le créer à la main.
# (Pour PostgreSQL ce serait `postgresql://user:pwd@host:5432/dbname`.)
DATABASE_URL=file:./dev.db

# J4 — Secret JWT (sera utilisé pour signer les tokens d'authentification)
# À laisser vide pour aujourd'hui, on s'en servira au J4.
JWT_SECRET=remplace-moi-en-prod
